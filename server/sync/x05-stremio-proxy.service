[Unit]
Description=X05 protected addon sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=x05-stremio
Group=x05-stremio
SupplementaryGroups=sync_authenticator
WorkingDirectory=/opt/x05-klipy
Environment=SUPABASE_ISSUER=https://eogwzrlfoercfwcfwlmv.supabase.co/auth/v1
Environment=VPS_AUTH_ISSUER=https://auth.x05-anime.example/auth/v1
Environment=SUPABASE_JWKS_PATH=/etc/x05-sync/jwks.json
# Keep this key across deployments; encrypted backups depend on it.
LoadCredential=stremio_key:/etc/x05-sync/stremio_key
ExecStart=/opt/x05-klipy/venv/bin/python /opt/x05-klipy/stremio_proxy.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
