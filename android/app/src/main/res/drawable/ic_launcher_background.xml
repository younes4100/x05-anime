<?xml version="1.0" encoding="utf-8"?>
<!-- X05 icon backdrop. The launcher crops this to its mask, so a plain
     diagonal gradient matches the artwork without any visible edges. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF0B1226"
        android:centerColor="#FF060A15"
        android:endColor="#FF03050B"
        android:type="linear" />
</shape>
